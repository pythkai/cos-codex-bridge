{
  "name": "grokbot-codex-bridge",
  "version": "0.3.0",
  "private": true,
  "description": "Local stdio MCP bridge that lets Grok Bot launch, resume, test and report Codex CLI tasks.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "grokbot-codex-bridge": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts/install.mjs",
    "scripts/Install.command",
    "scripts/demo.mjs",
    "scripts/e2e-mac.mjs",
    "README.md",
    "SECURITY.md",
    "INSTALLER.md",
    "NOTICE",
    "LICENSE",
    "docs/USAGE.md",
    "docs/CODEX-DRIVER.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "tsc --noEmit",
    "start": "node dist/cli.js",
    "demo": "node scripts/demo.mjs",
    "e2e:mac": "node scripts/e2e-mac.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "7.0.2"
  }
}
